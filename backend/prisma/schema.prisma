generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model api_keys {
  id                  Int        @id @default(autoincrement())
  user_id             Int
  name                String     @db.VarChar(255)
  key_prefix          String     @db.VarChar(16)
  key_hash            String     @db.VarChar(255)
  scopes              Json?      @default("[\"read\"]")
  rate_limit_per_hour Int?       @default(1000)
  last_used_at        DateTime?  @db.Timestamp(6)
  expires_at          DateTime?  @db.Timestamp(6)
  active              Boolean?   @default(true)
  created_at          DateTime?  @default(now()) @db.Timestamp(6)
  revoked_at          DateTime?  @db.Timestamp(6)
  users               users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  api_logs            api_logs[]

  @@index([user_id, active], map: "idx_api_keys_active")
  @@index([key_prefix], map: "idx_api_keys_prefix")
  @@index([user_id], map: "idx_api_keys_user")
}

model api_logs {
  id            Int       @id @default(autoincrement())
  user_id       Int
  api_key_id    Int?
  method        String    @db.VarChar(10)
  endpoint      String    @db.VarChar(255)
  status_code   Int?
  ip_address    String?   @db.VarChar(45)
  user_agent    String?
  duration_ms   Int?
  error_message String?
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  api_keys      api_keys? @relation(fields: [api_key_id], references: [id], onUpdate: NoAction)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_api_logs_date")
  @@index([api_key_id], map: "idx_api_logs_key")
  @@index([user_id], map: "idx_api_logs_user")
}

model appointments {
  id                  Int       @id @default(autoincrement())
  user_id             Int
  client_id           Int?
  client_name         String    @db.VarChar(255)
  client_email        String?   @db.VarChar(255)
  client_phone        String?   @db.VarChar(30)
  client_address      String?
  subject             String?   @db.VarChar(255)
  notes               String?
  appointment_date    DateTime  @db.Date
  start_time          DateTime  @db.Time(6)
  end_time            DateTime  @db.Time(6)
  duration_minutes    Int?      @default(60)
  status              String?   @default("pending") @db.VarChar(30)
  source              String?   @default("manual") @db.VarChar(30)
  reminder_sent_at    DateTime? @db.Timestamp(6)
  cancelled_at        DateTime? @db.Timestamp(6)
  cancellation_reason String?
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)
  clients             clients?  @relation(fields: [client_id], references: [id], onUpdate: NoAction)
  users               users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([client_email], map: "idx_appointments_email")
  @@index([user_id, status], map: "idx_appointments_status")
  @@index([user_id, appointment_date, start_time], map: "idx_appointments_user")
}

model assistant_learnings {
  id           BigInt    @id @default(autoincrement())
  user_id      Int
  pattern_type String
  context      String?
  observation  Json
  confidence   Float?    @default(0.0)
  count        Int?      @default(1)
  status       String?   @default("pending")
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  updated_at   DateTime? @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, pattern_type, context])
  @@index([user_id, status, pattern_type], map: "assistant_learnings_user_idx")
}

model assistant_memory {
  id          BigInt                 @id @default(autoincrement())
  user_id     Int
  memory_type String
  content     String
  embedding   Unsupported("vector")?
  metadata    Json?                  @default("{}")
  weight      Float?                 @default(1.0)
  created_at  DateTime?              @default(now()) @db.Timestamptz(6)
  updated_at  DateTime?              @default(now()) @db.Timestamptz(6)
  users       users                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([embedding])
  @@index([user_id, memory_type], map: "assistant_memory_user_idx")
}

model assistant_observations {
  id               Int       @id @default(autoincrement())
  user_id          Int
  observation_type String    @db.VarChar(50)
  context          String?   @db.VarChar(100)
  field            String    @db.VarChar(50)
  old_value        Decimal?  @db.Decimal(12, 2)
  new_value        Decimal?  @db.Decimal(12, 2)
  count            Int?      @default(1)
  status           String?   @default("pending") @db.VarChar(20)
  last_seen_at     DateTime? @default(now()) @db.Timestamp(6)
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, observation_type, context, field, new_value])
  @@index([user_id, status], map: "idx_assistant_observations_user_status")
}

model assistant_plans {
  id           BigInt    @id @default(autoincrement())
  user_id      Int
  user_message String
  plan         Json
  results      Json?     @default("[]")
  success      Boolean?  @default(false)
  duration_ms  Int?
  error        String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  users        users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "assistant_plans_user_idx")
}

model assistant_preferences {
  user_id                Int       @id
  hourly_rates           Json?     @default("{}")
  default_hourly_rate    Decimal?  @default(45.00) @db.Decimal(10, 2)
  default_margin_percent Decimal?  @default(0.00) @db.Decimal(5, 2)
  default_vat_regime     String?   @default("franchise") @db.VarChar(20)
  default_vat_rate       Decimal?  @default(21.00) @db.Decimal(5, 2)
  default_payment_terms  Int?      @default(30)
  preferred_suppliers    Json?     @default("{}")
  voice_corrections      Json?     @default("{}")
  misc                   Json?     @default("{}")
  created_at             DateTime? @default(now()) @db.Timestamp(6)
  updated_at             DateTime? @default(now()) @db.Timestamp(6)
  users                  users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model assistant_sessions {
  user_id           Int       @id
  last_quote_id     Int?
  last_quote_number String?   @db.VarChar(50)
  last_client_name  String?   @db.VarChar(255)
  last_action       String?   @db.VarChar(50)
  last_action_at    DateTime? @db.Timestamp(6)
  context           Json?     @default("{}")
  recent_history    Json?     @default("[]")
  created_at        DateTime? @default(now()) @db.Timestamp(6)
  updated_at        DateTime? @default(now()) @db.Timestamp(6)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id], map: "idx_assistant_sessions_user")
}

model assistant_suggestions {
  id                  Int        @id @default(autoincrement())
  user_id             Int
  suggestion_type     String     @db.VarChar(50)
  title               String     @db.VarChar(255)
  message             String?
  action_type         String?    @db.VarChar(50)
  action_payload      Json?
  related_quote_id    Int?
  related_invoice_id  Int?
  related_chantier_id Int?
  priority            Int?       @default(5)
  status              String?    @default("active") @db.VarChar(20)
  dismissed_at        DateTime?  @db.Timestamp(6)
  actioned_at         DateTime?  @db.Timestamp(6)
  expires_at          DateTime?  @db.Timestamp(6)
  created_at          DateTime?  @default(now()) @db.Timestamp(6)
  chantiers           chantiers? @relation(fields: [related_chantier_id], references: [id], onUpdate: NoAction)
  invoices            invoices?  @relation(fields: [related_invoice_id], references: [id], onUpdate: NoAction)
  quotes              quotes?    @relation(fields: [related_quote_id], references: [id], onUpdate: NoAction)
  users               users      @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, suggestion_type, status], map: "idx_suggestions_type")
  @@index([user_id, status, priority(sort: Desc), created_at(sort: Desc)], map: "idx_suggestions_user")
}

model assistant_training_data {
  id                BigInt    @id @default(autoincrement())
  user_id           Int
  messages          Json
  source            String?   @default("auto")
  quality_score     Float?    @default(1.0)
  used_for_training Boolean?  @default(false)
  created_at        DateTime? @default(now()) @db.Timestamptz(6)
  users             users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, used_for_training, quality_score], map: "assistant_training_user_idx")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model availability_slots {
  id         Int       @id @default(autoincrement())
  user_id    Int
  weekday    Int
  start_time DateTime  @db.Time(6)
  end_time   DateTime  @db.Time(6)
  active     Boolean?  @default(true)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, weekday, active], map: "idx_availability_user")
}

model bank_imports {
  id                 Int                 @id @default(autoincrement())
  user_id            Int
  filename           String?             @db.VarChar(255)
  original_name      String?             @db.VarChar(255)
  format             String?             @db.VarChar(30)
  transactions_count Int?                @default(0)
  reconciled_count   Int?                @default(0)
  error_message      String?
  created_at         DateTime?           @default(now()) @db.Timestamp(6)
  users              users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  bank_transactions  bank_transactions[]

  @@index([user_id, created_at(sort: Desc)], map: "idx_bank_imports_user")
}

model bank_transactions {
  id                 Int           @id @default(autoincrement())
  user_id            Int
  import_id          Int?
  transaction_date   DateTime      @db.Date
  value_date         DateTime?     @db.Date
  amount             Decimal       @db.Decimal(12, 2)
  currency           String?       @default("EUR") @db.VarChar(3)
  description        String?
  counterparty       String?       @db.VarChar(255)
  reference          String?       @db.VarChar(255)
  transaction_type   String?       @db.VarChar(20)
  matched_invoice_id Int?
  match_score        Int?
  match_reason       String?       @db.VarChar(255)
  status             String?       @default("pending") @db.VarChar(30)
  validated_at       DateTime?     @db.Timestamp(6)
  created_at         DateTime?     @default(now()) @db.Timestamp(6)
  bank_imports       bank_imports? @relation(fields: [import_id], references: [id], onUpdate: NoAction)
  invoices           invoices?     @relation(fields: [matched_invoice_id], references: [id], onUpdate: NoAction)
  users              users         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([matched_invoice_id], map: "idx_bank_transactions_invoice")
  @@index([user_id, status], map: "idx_bank_transactions_status")
  @@index([user_id, transaction_date(sort: Desc)], map: "idx_bank_transactions_user")
}

model chantier_events {
  id          Int       @id @default(autoincrement())
  user_id     Int
  chantier_id Int
  event_type  String    @db.VarChar(50)
  event_data  Json?
  created_at  DateTime? @default(now()) @db.Timestamp(6)
  chantiers   chantiers @relation(fields: [chantier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chantier_id], map: "idx_chantier_events_chantier")
}

model chantier_photos {
  id            Int       @id @default(autoincrement())
  user_id       Int
  chantier_id   Int
  filename      String    @db.VarChar(255)
  original_name String?   @db.VarChar(255)
  mime_type     String?   @db.VarChar(100)
  size_bytes    Int?
  caption       String?   @db.VarChar(500)
  uploaded_at   DateTime? @default(now()) @db.Timestamp(6)
  chantiers     chantiers @relation(fields: [chantier_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chantier_id], map: "idx_chantier_photos_chantier")
}

model chantiers {
  id                        Int                         @id @default(autoincrement())
  user_id                   Int
  name                      String                      @db.VarChar(255)
  reference                 String?                     @db.VarChar(50)
  description               String?
  client_id                 Int?
  client_name               String?                     @db.VarChar(255)
  client_address            String?
  status                    String?                     @default("planned") @db.VarChar(30)
  budget_estimate           Decimal?                    @db.Decimal(12, 2)
  budget_final              Decimal?                    @db.Decimal(12, 2)
  start_date                DateTime?                   @db.Date
  end_date                  DateTime?                   @db.Date
  completed_at              DateTime?                   @db.Timestamp(6)
  notes                     String?
  color                     String?                     @default("#f97316") @db.VarChar(20)
  created_at                DateTime?                   @default(now()) @db.Timestamp(6)
  updated_at                DateTime?                   @default(now()) @db.Timestamp(6)
  currency                  String?                     @default("EUR") @db.VarChar(3)
  assistant_suggestions     assistant_suggestions[]
  chantier_events           chantier_events[]
  chantier_photos           chantier_photos[]
  clients                   clients?                    @relation(fields: [client_id], references: [id], onUpdate: NoAction)
  users                     users                       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  client_conversations      client_conversations[]
  invoices                  invoices[]
  quotes                    quotes[]
  subcontractor_assignments subcontractor_assignments[]

  @@index([client_id], map: "idx_chantiers_client")
  @@index([user_id, status], map: "idx_chantiers_status")
  @@index([user_id], map: "idx_chantiers_user")
}

model client_account_logs {
  id                Int             @id @default(autoincrement())
  client_account_id Int
  user_id           Int
  action            String          @db.VarChar(50)
  ip_address        String?         @db.VarChar(45)
  user_agent        String?
  details           Json?
  created_at        DateTime?       @default(now()) @db.Timestamp(6)
  client_accounts   client_accounts @relation(fields: [client_account_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users             users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([client_account_id, created_at(sort: Desc)], map: "idx_client_logs_account")
  @@index([user_id, created_at(sort: Desc)], map: "idx_client_logs_user")
}

model client_accounts {
  id                     Int                   @id @default(autoincrement())
  user_id                Int
  client_id              Int
  email                  String                @unique @db.VarChar(255)
  password_hash          String?               @db.VarChar(255)
  invitation_token       String?               @db.VarChar(64)
  invitation_expires_at  DateTime?             @db.Timestamp(6)
  invitation_sent_at     DateTime?             @db.Timestamp(6)
  invitation_accepted_at DateTime?             @db.Timestamp(6)
  last_login_at          DateTime?             @db.Timestamp(6)
  active                 Boolean?              @default(true)
  created_at             DateTime?             @default(now()) @db.Timestamp(6)
  updated_at             DateTime?             @default(now()) @db.Timestamp(6)
  client_account_logs    client_account_logs[]
  clients                clients               @relation(fields: [client_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                  users                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, client_id])
  @@index([email], map: "idx_client_accounts_email")
  @@index([invitation_token], map: "idx_client_accounts_token")
  @@index([user_id], map: "idx_client_accounts_user")
}

model client_conversations {
  id                   Int               @id @default(autoincrement())
  user_id              Int
  client_id            Int?
  client_name          String?           @db.VarChar(255)
  client_email         String?           @db.VarChar(255)
  subject              String?           @db.VarChar(255)
  related_quote_id     Int?
  related_invoice_id   Int?
  related_chantier_id  Int?
  last_message_at      DateTime?         @default(now()) @db.Timestamp(6)
  last_message_preview String?
  owner_unread_count   Int?              @default(0)
  client_unread_count  Int?              @default(0)
  status               String?           @default("open") @db.VarChar(30)
  access_token         String?           @db.VarChar(64)
  created_at           DateTime?         @default(now()) @db.Timestamp(6)
  updated_at           DateTime?         @default(now()) @db.Timestamp(6)
  clients              clients?          @relation(fields: [client_id], references: [id], onUpdate: NoAction)
  chantiers            chantiers?        @relation(fields: [related_chantier_id], references: [id], onUpdate: NoAction)
  invoices             invoices?         @relation(fields: [related_invoice_id], references: [id], onUpdate: NoAction)
  quotes               quotes?           @relation(fields: [related_quote_id], references: [id], onUpdate: NoAction)
  users                users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  client_messages      client_messages[]

  @@index([client_id], map: "idx_conversations_client")
  @@index([access_token], map: "idx_conversations_token")
  @@index([user_id, owner_unread_count], map: "idx_conversations_unread")
  @@index([user_id, last_message_at(sort: Desc)], map: "idx_conversations_user")
}

model client_messages {
  id                   Int                  @id @default(autoincrement())
  conversation_id      Int
  sender_type          String               @db.VarChar(20)
  sender_name          String?              @db.VarChar(255)
  body                 String
  read_at              DateTime?            @db.Timestamp(6)
  created_at           DateTime?            @default(now()) @db.Timestamp(6)
  client_conversations client_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id, created_at], map: "idx_messages_conversation")
}

model clients {
  id                   Int                    @id @default(autoincrement())
  user_id              Int?
  name                 String                 @db.VarChar(255)
  contact_name         String?                @db.VarChar(255)
  email                String?                @db.VarChar(255)
  phone                String?                @db.VarChar(50)
  address              String?
  vat_number           String?                @db.VarChar(50)
  notes                String?
  created_at           DateTime?              @default(now()) @db.Timestamp(6)
  updated_at           DateTime?              @default(now()) @db.Timestamp(6)
  appointments         appointments[]
  chantiers            chantiers[]
  client_accounts      client_accounts[]
  client_conversations client_conversations[]
  users                users?                 @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  invoices             invoices[]
  quote_templates      quote_templates[]
  quotes               quotes[]
  recurring_invoices   recurring_invoices[]

  @@index([user_id, name], map: "idx_clients_name")
  @@index([user_id], map: "idx_clients_user")
}

model counters {
  user_id     Int   @id
  last_number Int?  @default(0)
  users       users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model email_imports {
  id             Int       @id @default(autoincrement())
  user_id        Int
  raw_text       String?
  from_email     String?   @db.VarChar(255)
  from_name      String?   @db.VarChar(255)
  subject        String?   @db.VarChar(500)
  received_at    DateTime? @db.Timestamp(6)
  extracted_data Json?
  quote_id       Int?
  status         String?   @default("pending") @db.VarChar(30)
  error_message  String?
  created_at     DateTime? @default(now()) @db.Timestamp(6)
  quotes         quotes?   @relation(fields: [quote_id], references: [id], onUpdate: NoAction)
  users          users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, status], map: "idx_email_imports_status")
  @@index([user_id, created_at(sort: Desc)], map: "idx_email_imports_user")
}

model email_log {
  id         Int       @id @default(autoincrement())
  user_id    Int?
  email_type String    @db.VarChar(50)
  sent_at    DateTime? @default(now()) @db.Timestamp(6)
  users      users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, email_type])
  @@index([email_type], map: "idx_email_log_type")
  @@index([user_id], map: "idx_email_log_user")
}

model exchange_rates {
  id              Int       @id @default(autoincrement())
  base_currency   String    @db.VarChar(3)
  target_currency String    @db.VarChar(3)
  rate            Decimal   @db.Decimal(12, 6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)

  @@unique([base_currency, target_currency])
}

model expiration_notifications {
  id       Int       @id @default(autoincrement())
  user_id  Int?
  quote_id Int?
  level    String    @db.VarChar(10)
  sent_at  DateTime? @default(now()) @db.Timestamp(6)
  quotes   quotes?   @relation(fields: [quote_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users?    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, quote_id, level])
  @@index([quote_id], map: "idx_exp_notif_quote")
  @@index([user_id], map: "idx_exp_notif_user")
}

model image_analyses {
  id                 Int       @id @default(autoincrement())
  user_id            Int
  filename           String    @db.VarChar(255)
  original_name      String?   @db.VarChar(255)
  mime_type          String?   @db.VarChar(100)
  size_bytes         Int?
  user_prompt        String?
  provider           String?   @db.VarChar(30)
  model              String?   @db.VarChar(100)
  result             Json?
  raw_response       String?
  duration_ms        Int?
  error_message      String?
  converted_quote_id Int?
  created_at         DateTime? @default(now()) @db.Timestamp(6)
  quotes             quotes?   @relation(fields: [converted_quote_id], references: [id], onUpdate: NoAction)
  users              users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([converted_quote_id], map: "idx_image_analyses_quote")
  @@index([user_id, created_at(sort: Desc)], map: "idx_image_analyses_user")
}

model invoice_counters {
  user_id     Int   @id
  last_number Int?  @default(0)
  users       users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model invoice_payment_schedules {
  id             Int       @id @default(autoincrement())
  user_id        Int
  invoice_id     Int
  position       Int
  label          String?   @db.VarChar(255)
  amount         Decimal   @db.Decimal(12, 2)
  due_date       DateTime  @db.Date
  paid_at        DateTime? @db.Timestamp(6)
  amount_paid    Decimal?  @default(0) @db.Decimal(12, 2)
  payment_method String?   @db.VarChar(50)
